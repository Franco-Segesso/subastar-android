<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/fondo_sec_b"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvConsignacionTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/texto_ppal"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConsignacionEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_inactivo"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="@color/texto_sec"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvConsignacionSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/texto_sec"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/bordes" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvConsignacionPrecio"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_redondeado"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:textColor="@color/texto_ppal"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvConsignacionSubasta"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_redondeado"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:textColor="@color/texto_ppal"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvConsignacionUbicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/texto_sec"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnVerDetalleConsignacion"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:gravity="center"
            android:text="Ver detalle  ->"
            android:textColor="@color/secundario"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
