<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primario"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVolverFactura"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/secundario" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Factura de compra"
                android:textColor="@color/texto_ppal"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/bordes" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_banner_estado"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvFacturaSubasta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFacturaItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/texto_ppal"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_pujas"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvFacturaImporte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_ppal"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvFacturaComision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/texto_ppal"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvFacturaEnvio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/texto_ppal"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/bordes" />

            <TextView
                android:id="@+id/tvFacturaTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/secundario"
                android:textSize="19sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MEDIO DE PAGO"
            android:textColor="@color/texto_sec"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSeleccionarMedioCompra"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_chip_inactivo"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="Seleccionar medio de pago"
            android:textColor="@color/texto_sec"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvFacturaModalidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/texto_ppal"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFacturaDireccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/texto_sec"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/contenedorModalidad"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnElegirEnvio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_activo"
                android:gravity="center"
                android:text="ENVÍO"
                android:textColor="@color/secundario"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnElegirRetiro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_inactivo"
                android:gravity="center"
                android:text="RETIRO"
                android:textColor="@color/texto_ppal"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvFacturaSeguro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_pujas"
            android:padding="14dp"
            android:textColor="@color/texto_sec"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnFinalizarCompra"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_chip_activo"
            android:gravity="center"
            android:text="FINALIZAR COMPRA"
            android:textColor="@color/secundario"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFacturaError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/error"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
