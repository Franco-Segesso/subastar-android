<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primario"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/secundario" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Cuenta destino"
                android:textColor="@color/texto_ppal"
                android:textSize="22sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/bordes" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Declará la cuenta donde querés recibir el dinero si tu bien se vende."
            android:textColor="@color/texto_sec"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Banco"
            android:textColor="@color/texto_sec"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etBanco"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_redondeado"
            android:inputType="textCapWords"
            android:paddingHorizontal="14dp"
            android:textColor="@color/texto_ppal"
            android:textColorHint="@color/texto_sec"
            android:hint="Ej: Banco Galicia"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CBU / IBAN"
            android:textColor="@color/texto_sec"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etCbu"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_redondeado"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/texto_ppal"
            android:textColorHint="@color/texto_sec"
            android:hint="CBU o IBAN"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="País"
            android:textColor="@color/texto_sec"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerPais"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_redondeado"
            android:paddingHorizontal="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Moneda"
            android:textColor="@color/texto_sec"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerMoneda"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_redondeado"
            android:paddingHorizontal="14dp" />

        <Button
            android:id="@+id/btnAgregarCbu"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/secundario"
            android:text="Guardar cuenta destino"
            android:textColor="@color/primario"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVolverMisConsignaciones"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/fondo_sec_b"
            android:text="VOLVER A MIS CONSIGNACIONES"
            android:textColor="@color/texto_ppal"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>