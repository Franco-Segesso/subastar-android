<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primario"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvBienvenido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido,"
        android:textColor="@color/texto_sec"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNombreUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Marcos González"
        android:textColor="@color/texto_ppal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBienvenido" />

    <ImageView
        android:id="@+id/btnPerfil"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_circulo_dorado"
        android:padding="8dp"
        android:src="@drawable/ic_person"
        app:tint="@color/secundario"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botón Notificaciones (Al lado del perfil) -->
    <ImageView
        android:id="@+id/btnNotificaciones"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_notifications"
        app:tint="@color/secundario"
        app:layout_constraintBottom_toBottomOf="@+id/btnPerfil"
        app:layout_constraintEnd_toStartOf="@+id/btnPerfil"
        app:layout_constraintTop_toTopOf="@+id/btnPerfil" />

    <EditText
        android:id="@+id/etBuscador"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_buscador"
        android:hint="Buscar subastas o artículos..."
        android:textColorHint="@color/texto_sec"
        android:textColor="@color/texto_ppal"
        android:paddingStart="20dp"
        android:drawableEnd="@android:drawable/ic_menu_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNombreUsuario" />

    <HorizontalScrollView
        android:id="@+id/scrollChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/etBuscador">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTodas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todas"
                android:textColor="@color/secundario"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_chip_activo"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipEnVivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En vivo"
                android:textColor="@color/texto_sec"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_chip_inactivo"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipComun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Común"
                android:textColor="@color/texto_sec"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_chip_inactivo"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipEspecial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Especial"
                android:textColor="@color/texto_sec"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_chip_inactivo"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipPlata"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plata"
                android:textColor="@color/texto_sec"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_chip_inactivo"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipOro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oro"
                android:textColor="@color/texto_sec"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_chip_inactivo"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/chipPlatino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Platino"
                android:textColor="@color/texto_sec"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@drawable/bg_chip_inactivo"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvProximas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRÓXIMAS SUBASTAS"
        android:textColor="@color/texto_sec"
        android:textSize="12sp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollChips" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewSubastas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvProximas"
        app:layout_constraintBottom_toTopOf="@+id/layoutFechaNav" />

    <LinearLayout
        android:id="@+id/layoutFechaNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnDiaAnterior"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/texto_sec"/>

        <TextView
            android:id="@+id/tvFechaActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&lt; HOY (27/05/26)"
            android:textAlignment="center"
            android:textColor="@color/texto_sec"
            android:textSize="14sp"
            android:layout_marginHorizontal="16dp"/>

        <ImageButton
            android:id="@+id/btnDiaSiguiente"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/texto_sec"
            android:visibility="invisible"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="16dp"
        android:background="@color/primario"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/navSubastas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SUBASTAS"
            android:textColor="@color/texto_ppal"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navMisPujas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MIS PUJAS"
            android:textColor="@color/texto_sec"
            android:gravity="center"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navConsignacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CONSIGNACIÓN"
            android:textColor="@color/texto_sec"
            android:gravity="center"
            android:textSize="12sp"/>
    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>