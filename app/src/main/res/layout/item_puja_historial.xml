<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:background="@color/primario">

    <!-- Avatar circular -->
    <ImageView
        android:id="@+id/ivAvatarPostor"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circulo_dorado"
        android:src="@drawable/ic_person"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Nombre del postor -->
    <TextView
        android:id="@+id/tvNombrePostor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/texto_ppal"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@+id/ivAvatarPostor"
        app:layout_constraintStart_toEndOf="@+id/ivAvatarPostor"
        tools:text="Marcos González"/>

    <!-- Hora -->
    <TextView
        android:id="@+id/tvHoraPuja"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_sec"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@+id/tvNombrePostor"
        app:layout_constraintStart_toStartOf="@+id/tvNombrePostor"
        tools:text="17:04:55"/>

    <!-- Monto -->
    <TextView
        android:id="@+id/tvMontoPuja"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_ppal"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@+id/tvNombrePostor"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="USD 4.900"/>

    <!-- Etiqueta (Ej: Mayor) -->
    <TextView
        android:id="@+id/tvEstadoPuja"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_ppal"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@+id/tvMontoPuja"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Mayor"/>

</androidx.constraintlayout.widget.ConstraintLayout>