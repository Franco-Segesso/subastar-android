<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="12dp"
    android:paddingHorizontal="16dp"> <com.google.android.material.card.MaterialCardView
    android:id="@+id/cardContenedor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/fondo_sec_b"
    app:strokeColor="@color/bordes"
    app:strokeWidth="1dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloSubasta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Colección de Relojes"
            android:textColor="@color/texto_ppal"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btnVer" />

        <TextView
            android:id="@+id/tvFechaSubasta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Lunes 23 de Marzo - 16:00 hs"
            android:textColor="@color/texto_sec"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTituloSubasta" />

        <TextView
            android:id="@+id/tvCategoriaSubasta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CATEGORÍA: ORO"
            android:textColor="@color/texto_sec"
            android:textSize="12sp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvFechaSubasta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVer"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VER ->"
            android:textColor="@color/texto_sec"
            app:strokeColor="@color/bordes"
            app:cornerRadius="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvEstadoSubasta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FINALIZADA"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textColor="@color/white"

        android:background="@drawable/bg_badge_relleno" android:backgroundTint="@color/error"            android:elevation="6dp"
        app:layout_constraintTop_toTopOf="@id/cardContenedor"
        app:layout_constraintEnd_toEndOf="@id/cardContenedor"
        android:layout_marginTop="-10dp"
        android:layout_marginEnd="-6dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
