<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="@color/fondo_sec_b"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_success_icon"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/secundario"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="COMPRA REALIZADA"
            android:textColor="@color/texto_ppal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCompraExitosaDetalle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/texto_sec"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCompraExitosaFactura"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/secundario"
            android:text="VER FACTURA"
            android:textColor="@color/primario"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCompraExitosaSubastas"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/bordes"
            android:text="VOLVER A SUBASTAS"
            android:textColor="@color/texto_ppal" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
