<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/fondo_sec_b"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_dialog_alert"
            app:tint="@color/error" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Atención!"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/texto_ppal"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvMensajeError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mensaje de error aquí"
            android:textSize="16sp"
            android:textColor="@color/texto_sec"
            android:textAlignment="center"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnEntendidoError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/error"
            android:textColor="@color/white"
            android:text="Entendido"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>