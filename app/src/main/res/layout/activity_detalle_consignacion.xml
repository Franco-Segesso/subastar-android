<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primario"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/secundario" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Detalle del Bien"
            android:textColor="@color/texto_ppal"
            android:textSize="22sp" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="@color/bordes" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetalleIconoEstado"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/tvDetalleTituloBien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/texto_sec"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layoutConsignacionRechazada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_multa_pendiente"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONSIGNACION RECHAZADA"
                    android:textColor="@color/error"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMotivoRechazoConsignacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/texto_ppal"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvCostoDevolucionConsignacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/secundario"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInstruccionDevolucionConsignacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/texto_sec"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/layoutCondiciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_caja_lista"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Condiciones propuestas" android:textColor="@color/texto_ppal" android:textSize="18sp" />
                <TextView android:id="@+id/tvCondicionesDetalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/texto_sec" android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutDocumentacionOrigen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_caja_lista"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Documentacion de origen"
                    android:textColor="@color/texto_ppal"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMotivoDocumentacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/texto_sec"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSeleccionarDocumentos"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/fondo_sec_b"
                    android:text="SELECCIONAR ARCHIVOS"
                    android:textColor="@color/texto_ppal" />

                <TextView
                    android:id="@+id/tvCantidadDocumentos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0 archivos seleccionados"
                    android:textColor="@color/texto_sec"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etDescripcionDocumentacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:hint="Descripcion adicional (opcional)"
                    android:minHeight="56dp"
                    android:padding="12dp"
                    android:textColor="@color/texto_ppal"
                    android:textColorHint="@color/black" />

                <Button
                    android:id="@+id/btnEnviarDocumentacion"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/secundario"
                    android:text="ENVIAR DOCUMENTACION"
                    android:textColor="@color/primario"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDocumentosPresentados"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/texto_sec"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvUbicacionTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Ubicacion del bien"
                android:textColor="@color/texto_sec"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvUbicacionDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_caja_lista"
                android:padding="16dp"
                android:textColor="@color/texto_ppal"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSeguroTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Poliza de seguro"
                android:textColor="@color/texto_sec"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSeguroDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_caja_lista"
                android:padding="16dp"
                android:textColor="@color/texto_ppal"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnContactarAseguradora"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/secundario"
                android:text="CONTACTAR ASEGURADORA"
                android:textColor="@color/primario"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutAccionesCondiciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnRechazarCondiciones"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/fondo_sec_b"
            android:text="Rechazar condiciones"
            android:textColor="@color/texto_ppal" />

        <Button
            android:id="@+id/btnAceptarCondiciones"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:backgroundTint="@color/secundario"
            android:text="ACEPTAR  ->"
            android:textColor="@color/primario" />
    </LinearLayout>
</LinearLayout>
