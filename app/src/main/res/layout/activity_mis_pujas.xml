<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primario"
    android:orientation="vertical"
    android:paddingTop="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp">

        <ImageButton
            android:id="@+id/btnVolverMisPujas"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/secundario" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Mis Pujas"
            android:textColor="@color/texto_ppal"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnMisMetricas"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_inactivo"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="MÉTRICAS"
            android:textColor="@color/secundario"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTotalSubastas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_pujas"
            android:gravity="center"
            android:text="0\nSUBASTAS"
            android:textColor="@color/texto_ppal"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubastasGanadas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_pujas"
            android:gravity="center"
            android:text="0\nGANADAS"
            android:textColor="@color/texto_ppal"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPorcentajeExito"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_card_pujas"
            android:gravity="center"
            android:text="0%\nÉXITO"
            android:textColor="@color/texto_ppal"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/chipPujasTodas"
                style="@style/ConsignacionChip"
                android:text="Todas" />

            <TextView
                android:id="@+id/chipPujasGanadas"
                style="@style/ConsignacionChip"
                android:text="Ganadas" />

            <TextView
                android:id="@+id/chipPujasPerdidas"
                style="@style/ConsignacionChip"
                android:text="Perdidas" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvMisPujasVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:gravity="center"
        android:text="Todavía no participaste en subastas."
        android:textColor="@color/texto_sec"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMisPujas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:paddingVertical="16dp"
        android:background="@color/primario">

        <TextView
            android:id="@+id/navPujasSubastas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SUBASTAS"
            android:textColor="@color/texto_sec"
            android:gravity="center"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navMisPujas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MIS PUJAS"
            android:textColor="@color/texto_ppal"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/navPujasConsignacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CONSIGNACIÓN"
            android:textColor="@color/texto_sec"
            android:gravity="center"
            android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
