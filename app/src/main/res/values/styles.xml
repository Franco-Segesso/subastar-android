<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ConsignacionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/texto_sec</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ConsignacionInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input_redondeado</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/texto_ppal</item>
        <item name="android:textColorHint">@color/texto_sec</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ConsignacionChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_chip_inactivo</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:textColor">@color/texto_ppal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
