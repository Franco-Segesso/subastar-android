<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Subastarandroid" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/secundario</item>
        <item name="android:colorBackground">@color/primario</item>
        <item name="android:windowBackground">@color/primario</item>
        <item name="colorOnBackground">@color/texto_ppal</item>
        <item name="android:textColor">@color/texto_ppal</item>
        <item name="android:textColorSecondary">@color/texto_sec</item>
        <item name="colorError">@color/error</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Subastarandroid" parent="Base.Theme.Subastarandroid" />

    <style name="Theme.SplashInicial" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primario</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Subastarandroid</item>
    </style>
</resources>
