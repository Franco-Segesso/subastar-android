<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo del mismo color que la pantalla (o transparente) -->
    <solid android:color="@color/primario" />

    <!-- Contorno con el color exacto que pediste -->
    <stroke android:width="1dp" android:color="@color/bordes" />

    <!-- Bordes un poco redondeados para que quede moderno -->
    <corners android:radius="12dp" />
</shape>